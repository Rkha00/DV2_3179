{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart: average yearly NDIS plan budget per child aged 0-14, by disability group, June 2026. The red line is the average for all children.",
  "width": 260,
  "height": 250,
  "data": {
    "url": "data/ndis_children_national_group_age.csv"
  },
  "transform": [
    {
      "calculate": "datum.participants * datum.avg_annual_budget",
      "as": "total"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "total",
          "as": "total"
        },
        {
          "op": "sum",
          "field": "participants",
          "as": "participants"
        }
      ],
      "groupby": [
        "disability_group"
      ]
    },
    {
      "calculate": "datum.total / datum.participants",
      "as": "avg_budget"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "total",
          "as": "all_total"
        },
        {
          "op": "sum",
          "field": "participants",
          "as": "all_participants"
        }
      ]
    },
    {
      "calculate": "datum.all_total / datum.all_participants",
      "as": "all_avg"
    },
    {
      "calculate": "datum.disability_group == 'Autism' || datum.disability_group == 'Developmental delay'",
      "as": "focus"
    }
  ],
  "encoding": {
    "y": {
      "field": "disability_group",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "avg_budget",
      "type": "quantitative",
      "title": "Average yearly budget per child",
      "scale": {
        "domain": [
          0,
          95000
        ]
      },
      "axis": {
        "values": [
          0,
          20000,
          40000,
          60000,
          80000
        ],
        "labelExpr": "'$' + datum.value / 1000 + 'k'",
        "grid": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#d1495b",
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "aggregate": "mean",
          "field": "all_avg",
          "type": "quantitative"
        },
        "y": null
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x2": {
          "datum": 0
        },
        "color": {
          "condition": {
            "test": "datum.focus",
            "value": "#1b5f63"
          },
          "value": "#c4cbd3"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.focus",
            "value": "#1b5f63"
          },
          "value": "#9aa5b1"
        },
        "tooltip": [
          {
            "field": "disability_group",
            "title": "Disability group"
          },
          {
            "field": "avg_budget",
            "title": "Average yearly budget",
            "format": "$,.0f"
          },
          {
            "field": "participants",
            "title": "Children",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', Arial, sans-serif",
        "fontSize": 13,
        "align": "left",
        "dx": 10,
        "color": "#616e7c"
      },
      "encoding": {
        "text": {
          "field": "avg_budget",
          "format": "$,.0f"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "all_avg",
              "as": "all_avg"
            }
          ]
        },
        {
          "calculate": "'All children: ' + format(datum.all_avg, '$,.0f')",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', Arial, sans-serif",
        "fontSize": 12,
        "color": "#d1495b",
        "fontWeight": 600,
        "align": "left",
        "dx": 4,
        "y": -8
      },
      "encoding": {
        "x": {
          "field": "all_avg",
          "type": "quantitative"
        },
        "y": null,
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "'Source Sans 3', Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "'Source Sans 3', Arial, sans-serif",
      "titleFont": "'Source Sans 3', Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1f2933",
      "titleColor": "#616e7c",
      "titleFontWeight": 600,
      "labelLimit": 320,
      "gridColor": "#e4e7eb",
      "domainColor": "#9aa5b1",
      "tickColor": "#9aa5b1",
      "labelAngle": 0
    },
    "legend": {
      "labelFont": "'Source Sans 3', Arial, sans-serif",
      "titleFont": "'Source Sans 3', Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1f2933",
      "titleColor": "#1f2933",
      "labelLimit": 320,
      "titleLimit": 320
    },
    "title": {
      "font": "'Source Sans 3', Arial, sans-serif",
      "color": "#1f2933"
    },
    "text": {
      "font": "'Source Sans 3', Arial, sans-serif",
      "fontSize": 13,
      "color": "#1f2933"
    }
  }
}