{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected dot plot: percentage of school students aged 5-20 with disability receiving each type of support, autistic students compared with students with other disability, 2022 (ABS SDAC).",
  "width": 420,
  "height": 250,
  "data": {
    "url": "data/autism_school_experience.csv"
  },
  "transform": [
    {
      "filter": "datum.category == 'Support received' && datum.item != 'Other support'"
    },
    {
      "calculate": "datum.group == 'Autistic' ? 'Autistic students' : 'Students with other disability'",
      "as": "who"
    }
  ],
  "encoding": {
    "y": {
      "field": "item",
      "type": "nominal",
      "title": null,
      "sort": [
        "Special tuition",
        "Counsellor or disability support person",
        "Special assessment procedure",
        "Special equipment",
        "Special access arrangements",
        "Special transport arrangements"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "grid": true,
        "labelPadding": 8
      }
    },
    "x": {
      "field": "percent",
      "type": "quantitative",
      "title": "Students receiving this support (%)",
      "scale": {
        "domain": [
          0,
          40
        ]
      },
      "axis": {
        "grid": false,
        "values": [
          0,
          10,
          20,
          30,
          40
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#c4cbd3",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "item"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 140,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "field": "who",
          "type": "nominal",
          "scale": {
            "domain": [
              "Autistic students",
              "Students with other disability"
            ],
            "range": [
              "#1b5f63",
              "#9aa5b1"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "who",
            "title": "Group"
          },
          {
            "field": "item",
            "title": "Support"
          },
          {
            "field": "percent",
            "title": "Receiving it (%)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.group == 'Autistic' && (datum.item == 'Special tuition' || datum.item == 'Counsellor or disability support person')"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', Arial, sans-serif",
        "fontSize": 13,
        "align": "left",
        "dx": 10,
        "fontWeight": 700,
        "color": "#1b5f63"
      },
      "encoding": {
        "text": {
          "field": "percent",
          "format": ".0f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "percent": 12.5,
            "item": "Special access arrangements",
            "t": "Autistic students are more than twice as likely",
            "dy": 0
          },
          {
            "percent": 12.5,
            "item": "Special access arrangements",
            "t": "to have a counsellor or disability support person",
            "dy": 15
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', Arial, sans-serif",
        "fontSize": 12,
        "color": "#d1495b",
        "fontWeight": 600,
        "align": "left",
        "dy": -6
      },
      "encoding": {
        "x": {
          "field": "percent",
          "type": "quantitative"
        },
        "y": {
          "field": "item",
          "type": "nominal"
        },
        "text": {
          "field": "t"
        },
        "yOffset": {
          "field": "dy",
          "type": "quantitative",
          "scale": null
        }
      }
    }
  ],
  "config": {
    "font": "'Source Sans 3', Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "'Source Sans 3', Arial, sans-serif",
      "titleFont": "'Source Sans 3', Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1f2933",
      "titleColor": "#616e7c",
      "titleFontWeight": 600,
      "labelLimit": 320,
      "gridColor": "#e4e7eb",
      "domainColor": "#9aa5b1",
      "tickColor": "#9aa5b1",
      "labelAngle": 0
    },
    "legend": {
      "labelFont": "'Source Sans 3', Arial, sans-serif",
      "titleFont": "'Source Sans 3', Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1f2933",
      "titleColor": "#1f2933",
      "labelLimit": 320,
      "titleLimit": 320
    },
    "title": {
      "font": "'Source Sans 3', Arial, sans-serif",
      "color": "#1f2933"
    },
    "text": {
      "font": "'Source Sans 3', Arial, sans-serif",
      "fontSize": 13,
      "color": "#1f2933"
    }
  }
}