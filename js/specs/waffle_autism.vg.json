{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: 1,000 squares represent 1,000 children aged 5-14. Dark squares show the 28 per 1,000 who were autistic at the 2015 rate; lighter squares show the extra 15 per 1,000 by 2022 (43 per 1,000, or 4.3%). Source: ABS SDAC 2015 and 2022.",
  "width": 470,
  "height": 190,
  "data": {
    "sequence": {
      "start": 0,
      "stop": 1000,
      "as": "i"
    }
  },
  "transform": [
    {
      "calculate": "floor(datum.i / 20)",
      "as": "col"
    },
    {
      "calculate": "datum.i % 20",
      "as": "row"
    },
    {
      "calculate": "datum.i < 28 ? 'Autistic at the 2015 rate (28 in 1,000)' : datum.i < 43 ? 'Extra by 2022 (15 more in 1,000)' : 'Not autistic'",
      "as": "group"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 1.5
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "paddingInner": 0.18
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "paddingInner": 0.18
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Autistic at the 2015 rate (28 in 1,000)",
              "Extra by 2022 (15 more in 1,000)",
              "Not autistic"
            ],
            "range": [
              "#1b5f63",
              "#4c9f97",
              "#dfe3e7"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "direction": "vertical",
            "symbolType": "square",
            "symbolSize": 160
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Each square is one child"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "'Source Sans 3', Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "'Source Sans 3', Arial, sans-serif",
      "titleFont": "'Source Sans 3', Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1f2933",
      "titleColor": "#616e7c",
      "titleFontWeight": 600,
      "labelLimit": 320,
      "gridColor": "#e4e7eb",
      "domainColor": "#9aa5b1",
      "tickColor": "#9aa5b1",
      "labelAngle": 0
    },
    "legend": {
      "labelFont": "'Source Sans 3', Arial, sans-serif",
      "titleFont": "'Source Sans 3', Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1f2933",
      "titleColor": "#1f2933",
      "labelLimit": 320,
      "titleLimit": 320
    },
    "title": {
      "font": "'Source Sans 3', Arial, sans-serif",
      "color": "#1f2933"
    },
    "text": {
      "font": "'Source Sans 3', Arial, sans-serif",
      "fontSize": 13,
      "color": "#1f2933"
    }
  }
}