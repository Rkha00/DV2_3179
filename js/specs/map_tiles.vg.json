{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Tile grid cartogram: each state and territory is an equal-sized square in roughly its geographic position. Colour shows children on the NDIS per 1,000 children for the disability group chosen with the buttons (June 2026).",
  "width": 330,
  "height": 330,
  "params": [
    {
      "name": "group",
      "value": "Autism",
      "bind": {
        "input": "radio",
        "options": [
          "Autism",
          "Developmental delay",
          "Intellectual disability"
        ],
        "name": "Show: "
      }
    }
  ],
  "data": {
    "url": "data/ndis_children_state_group_age.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "participants",
          "as": "participants"
        }
      ],
      "groupby": [
        "state",
        "state_name",
        "disability_group"
      ]
    },
    {
      "filter": "datum.disability_group == group"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/child_population_by_state.csv"
        },
        "key": "state",
        "fields": [
          "pop_0_14"
        ]
      }
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/ndis_children_by_state.csv"
        },
        "key": "state",
        "fields": [
          "tile_col",
          "tile_row"
        ]
      }
    },
    {
      "calculate": "datum.participants / datum.pop_0_14 * 1000",
      "as": "per_1000"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "per_1000",
          "as": "max_rate"
        }
      ]
    },
    {
      "calculate": "toNumber(datum.tile_col)",
      "as": "col"
    },
    {
      "calculate": "toNumber(datum.tile_row)",
      "as": "row"
    }
  ],
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "paddingInner": 0.08
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "paddingInner": 0.08
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 4
      },
      "encoding": {
        "color": {
          "field": "per_1000",
          "type": "quantitative",
          "scale": {
            "range": [
              "#e3f1ee",
              "#1b5f63"
            ],
            "zero": true
          },
          "legend": {
            "title": [
              "Per 1,000",
              "children"
            ],
            "orient": "none",
            "legendX": 0,
            "legendY": 195,
            "direction": "vertical",
            "gradientLength": 110
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State or territory"
          },
          {
            "field": "disability_group",
            "title": "Disability group"
          },
          {
            "field": "per_1000",
            "title": "Per 1,000 children",
            "format": ".1f"
          },
          {
            "field": "participants",
            "title": "Number of children",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "fill": null,
        "stroke": "#d1495b",
        "strokeWidth": 3
      },
      "transform": [
        {
          "filter": "datum.per_1000 == datum.max_rate"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', Arial, sans-serif",
        "fontSize": 15,
        "fontWeight": 700,
        "dy": -9
      },
      "encoding": {
        "text": {
          "field": "state"
        },
        "color": {
          "condition": {
            "test": "datum.per_1000 >= datum.max_rate * 0.6",
            "value": "#ffffff"
          },
          "value": "#1f2933"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', Arial, sans-serif",
        "fontSize": 14,
        "dy": 10
      },
      "encoding": {
        "text": {
          "field": "per_1000",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.per_1000 >= datum.max_rate * 0.6",
            "value": "#ffffff"
          },
          "value": "#1f2933"
        }
      }
    }
  ],
  "config": {
    "font": "'Source Sans 3', Arial, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "'Source Sans 3', Arial, sans-serif",
      "titleFont": "'Source Sans 3', Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1f2933",
      "titleColor": "#616e7c",
      "titleFontWeight": 600,
      "labelLimit": 320,
      "gridColor": "#e4e7eb",
      "domainColor": "#9aa5b1",
      "tickColor": "#9aa5b1",
      "labelAngle": 0
    },
    "legend": {
      "labelFont": "'Source Sans 3', Arial, sans-serif",
      "titleFont": "'Source Sans 3', Arial, sans-serif",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#1f2933",
      "titleColor": "#1f2933",
      "labelLimit": 320,
      "titleLimit": 320
    },
    "title": {
      "font": "'Source Sans 3', Arial, sans-serif",
      "color": "#1f2933"
    },
    "text": {
      "font": "'Source Sans 3', Arial, sans-serif",
      "fontSize": 13,
      "color": "#1f2933"
    }
  }
}